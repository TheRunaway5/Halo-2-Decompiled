include_guard(GLOBAL)
option(HALO2_NATIVE_EXECUTION_ACCOUNTING "Count literal-instruction function entries and statement execution in disposable aliases" OFF)
if(BUILD_TESTING)
    add_custom_target(native_execution_accounting_tests)
    add_test(NAME native_execution_accounting
        COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/tests/test_native_execution_accounting.py")
    set_tests_properties(native_execution_accounting PROPERTIES TIMEOUT 120)
endif()

if(HALO2_NATIVE_EXECUTION_ACCOUNTING)
    if(NOT DEFINED ENV{HALO2_TEST_SCRATCH} OR "$ENV{HALO2_TEST_SCRATCH}" STREQUAL "")
        message(FATAL_ERROR "Native execution accounting requires tools/run_test.py or tools/run_tests.py owned storage")
    endif()
    file(REAL_PATH "$ENV{HALO2_TEST_SCRATCH}" accounting_owner)
    file(RELATIVE_PATH accounting_relative "${accounting_owner}" "${CMAKE_BINARY_DIR}")
    if(accounting_relative MATCHES "^\\.\\.")
        message(FATAL_ERROR "Native execution accounting build must stay inside HALO2_TEST_SCRATCH")
    endif()
    add_library(halo2_native_execution_accounting STATIC
        "${PROJECT_SOURCE_DIR}/src/runtime/native_execution_accounting.cpp")
    target_include_directories(halo2_native_execution_accounting PUBLIC "${PROJECT_SOURCE_DIR}/include")
    target_compile_features(halo2_native_execution_accounting PUBLIC cxx_std_20)
endif()

# Call after complete-body binding/operand specialization, before partitioning.
function(halo2_native_accounting_source output source canonical)
    if(NOT HALO2_NATIVE_EXECUTION_ACCOUNTING)
        set(${output} "${source}" PARENT_SCOPE)
        return()
    endif()
    get_filename_component(input "${source}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    get_filename_component(original "${canonical}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${original}")
    if(relative MATCHES "^\\.\\." OR NOT relative MATCHES "^src/.+\\.cpp$")
        message(FATAL_ERROR "Unowned canonical execution accounting source: ${original}")
    endif()
    string(SHA256 variant "${input}")
    string(SUBSTRING "${variant}" 0 16 variant)
    set(instrumented "${CMAKE_BINARY_DIR}/native-execution/${variant}/${relative}")
    string(REGEX REPLACE "\\.cpp$" ".execution.json" receipt "${instrumented}")
    get_property(registered GLOBAL PROPERTY "HALO2_EXECUTION_ALIAS_${variant}_${relative}")
    if(registered)
        set(${output} "${instrumented}" PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL PROPERTY "HALO2_EXECUTION_ALIAS_${variant}_${relative}" TRUE)
    add_custom_command(OUTPUT "${instrumented}" "${receipt}"
        COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/tools/instrument_native_execution.py"
            --root "${PROJECT_SOURCE_DIR}" --canonical "${original}"
            --source "${input}" --output "${instrumented}" --manifest "${receipt}"
            --depfile "${instrumented}.d"
        DEPENDS "${input}" "${original}" "${PROJECT_SOURCE_DIR}/tools/instrument_native_execution.py"
            "${PROJECT_SOURCE_DIR}/tools/audit_native_migration_inventory.py"
            "${PROJECT_SOURCE_DIR}/tools/generated_routine_ownership.py"
            "${PROJECT_SOURCE_DIR}/tools/native_service_observations.py"
            "${PROJECT_SOURCE_DIR}/tools/perf_4k60/census_common.py"
        DEPFILE "${instrumented}.d"
        COMMENT "Accounting native/default and literal routes in ${relative}" VERBATIM)
    foreach(property COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
        get_source_file_property(value "${input}" ${property})
        if(value AND NOT value STREQUAL "NOTFOUND")
            set_source_files_properties("${instrumented}" PROPERTIES ${property} "${value}")
        endif()
    endforeach()
    get_filename_component(original_directory "${original}" DIRECTORY)
    set_property(SOURCE "${instrumented}" APPEND PROPERTY INCLUDE_DIRECTORIES "${original_directory}")
    set_property(GLOBAL APPEND PROPERTY HALO2_EXECUTION_ACCOUNTING_OUTPUTS "${instrumented}" "${receipt}")
    set(${output} "${instrumented}" PARENT_SCOPE)
endfunction()

function(halo2_native_accounting_target target)
    if(NOT HALO2_NATIVE_EXECUTION_ACCOUNTING OR NOT TARGET ${target})
        return()
    endif()
    get_target_property(imported ${target} IMPORTED)
    get_target_property(type ${target} TYPE)
    if(imported OR type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
        return()
    endif()
    get_target_property(base ${target} SOURCE_DIR)
    get_target_property(sources ${target} SOURCES)
    set(updated)
    set(accounted FALSE)
    foreach(source IN LISTS sources)
        if(source MATCHES "^\\$<")
            list(APPEND updated "${source}")
            continue()
        endif()
        get_filename_component(input "${source}" ABSOLUTE BASE_DIR "${base}")
        if(input MATCHES "/native-execution/" OR input MATCHES "/native-translations/")
            list(APPEND updated "${source}")
            set(accounted TRUE)
            continue()
        endif()
        if(NOT input MATCHES "\\.cpp$")
            list(APPEND updated "${source}")
            continue()
        endif()
        file(RELATIVE_PATH relative "${CMAKE_BINARY_DIR}/native-operands" "${input}")
        if(NOT relative MATCHES "^\\.\\.")
            set(canonical "${PROJECT_SOURCE_DIR}/src/${relative}")
        else()
            set(canonical "${input}")
        endif()
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${canonical}")
        set(eligible FALSE)
        if(EXISTS "${canonical}" AND relative MATCHES "^src/.+\\.cpp$")
            if(canonical MATCHES "_generated\\.cpp$")
                set(eligible TRUE)
            else()
                file(READ "${canonical}" candidate)
                if(candidate MATCHES "(^|[^A-Za-z_])instruction(_literal)?[ \t\r\n]*\\([ \t\r\n]*0x")
                    set(eligible TRUE)
                endif()
            endif()
        endif()
        if(eligible)
            halo2_native_accounting_source(alias "${input}" "${canonical}")
            list(APPEND updated "${alias}")
            set(accounted TRUE)
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(accounted)
        set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
        target_link_libraries(${target} PRIVATE halo2_native_execution_accounting)
    endif()
endfunction()

function(halo2_native_accounting_directory directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        halo2_native_accounting_target(${target})
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        halo2_native_accounting_directory("${child}")
    endforeach()
endfunction()

function(halo2_native_accounting_all_targets)
    halo2_native_accounting_directory("${PROJECT_SOURCE_DIR}")
    get_property(outputs GLOBAL PROPERTY HALO2_EXECUTION_ACCOUNTING_OUTPUTS)
    if(outputs)
        add_custom_target(native_execution_accounting_aliases
            COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/tools/native_execution_report.py"
                --manifests "${CMAKE_BINARY_DIR}/native-execution" --source-root "${PROJECT_SOURCE_DIR}"
                --output "${CMAKE_BINARY_DIR}/native-execution-coverage.json"
            DEPENDS ${outputs} "${PROJECT_SOURCE_DIR}/tools/native_execution_report.py" VERBATIM)
    endif()
endfunction()
if(HALO2_NATIVE_EXECUTION_ACCOUNTING)
    cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL halo2_native_accounting_all_targets)
endif()
