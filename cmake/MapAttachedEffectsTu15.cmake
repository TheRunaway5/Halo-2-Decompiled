target_sources(halo2_systems PRIVATE src/source_attached_effect.cpp)
if(BUILD_TESTING)
    add_executable(source_attached_effect_tests tests/source_attached_effect_tests.cpp)
    target_link_libraries(source_attached_effect_tests PRIVATE halo2_systems)
    add_test(NAME native_tu15_attached_effect_readback COMMAND source_attached_effect_tests)
    add_executable(source_named_map_effects_tests tests/source_named_map_effects_tests.cpp)
    target_link_libraries(source_named_map_effects_tests PRIVATE halo2_systems)
    foreach(map IN ITEMS containment turf dune)
        if(map STREQUAL containment)
            set(prepared 10)
        elseif(map STREQUAL turf)
            set(prepared 4)
        else()
            set(prepared 6)
        endif()
        add_test(NAME native_tu15_named_map_effects_${map} COMMAND source_named_map_effects_tests
            "${HALO2_TU15_GAMEPLAY_XBE}" "${CMAKE_CURRENT_SOURCE_DIR}/assets/map-pack/maps/${map}.map" ${prepared})
        set_tests_properties(native_tu15_named_map_effects_${map} PROPERTIES SKIP_RETURN_CODE 77)
    endforeach()
    add_executable(source_attached_effect_network_tests tests/source_attached_effect_network_tests.cpp)
    target_link_libraries(source_attached_effect_network_tests PRIVATE halo2_systems)
    add_test(NAME native_tu15_attached_effect_udp COMMAND source_attached_effect_network_tests
        "${HALO2_TU15_GAMEPLAY_XBE}" "${CMAKE_CURRENT_SOURCE_DIR}/assets/map-pack/maps/turf.map")
    set_tests_properties(native_tu15_attached_effect_udp PROPERTIES SKIP_RETURN_CODE 77)
endif()
