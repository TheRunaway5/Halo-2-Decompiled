if(BUILD_TESTING AND NOT MSVC AND CMAKE_SYSTEM_PROCESSOR MATCHES "^([xX]86_64|[aA][mM][dD]64|[xX]64)$")
    add_executable(campaign_reference_capture_tests EXCLUDE_FROM_ALL tests/campaign_reference_capture_tests.cpp)
    target_include_directories(campaign_reference_capture_tests PRIVATE include src)
    target_link_libraries(campaign_reference_capture_tests PRIVATE SDL2::SDL2 OpenSSL::Crypto nlohmann_json::nlohmann_json)
    target_compile_features(campaign_reference_capture_tests PRIVATE cxx_std_20)
    target_compile_options(campaign_reference_capture_tests PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
    if(HALO2_SANITIZERS)
        target_compile_options(campaign_reference_capture_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(campaign_reference_capture_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME native_campaign_reference_capture COMMAND campaign_reference_capture_tests)
    set_tests_properties(native_campaign_reference_capture PROPERTIES TIMEOUT 60)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_Interpreter_FOUND)
        add_test(NAME native_campaign_reference_capture_driver
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/campaign_reference_capture_driver_tests.py")
        set_tests_properties(native_campaign_reference_capture_driver PROPERTIES TIMEOUT 30)
    endif()
endif()
