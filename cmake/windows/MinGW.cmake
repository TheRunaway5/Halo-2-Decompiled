# Native PE32+ x86-64 builds from Linux. Host build tools remain Linux binaries.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
get_filename_component(_halo2_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT HALO2_WINDOWS_SDK)
    if(DEFINED ENV{HALO2_WINDOWS_SDK})
        set(HALO2_WINDOWS_SDK "$ENV{HALO2_WINDOWS_SDK}")
    else()
        set(HALO2_WINDOWS_SDK "${_halo2_root}/.tools/windows-sdk/mingw64")
    endif()
endif()
set(HALO2_WINDOWS_SDK "${HALO2_WINDOWS_SDK}" CACHE PATH "Native Windows dependency SDK")
set(CMAKE_FIND_ROOT_PATH "${HALO2_WINDOWS_SDK}" /usr/x86_64-w64-mingw32)
set(CMAKE_PREFIX_PATH "${HALO2_WINDOWS_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
get_filename_component(_halo2_sdk_parent "${HALO2_WINDOWS_SDK}" DIRECTORY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${_halo2_sdk_parent}")
set(ENV{PKG_CONFIG_LIBDIR} "${HALO2_WINDOWS_SDK}/lib/pkgconfig;${HALO2_WINDOWS_SDK}/share/pkgconfig")
string(REPLACE ";" ":" _halo2_pkg_path "$ENV{PKG_CONFIG_LIBDIR}")
set(ENV{PKG_CONFIG_LIBDIR} "${_halo2_pkg_path}")
set(ENV{PKG_CONFIG_PATH} "")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES HALO2_WINDOWS_SDK)
set(CMAKE_C_FLAGS_INIT "-D_WIN32_WINNT=0x0A00 -DWIN32_LEAN_AND_MEAN")
set(CMAKE_CXX_FLAGS_INIT "-D_WIN32_WINNT=0x0A00 -DWIN32_LEAN_AND_MEAN -DNOMINMAX -DSDL_MAIN_HANDLED")
# Generated native kernels are called through the same exported C++ interfaces.
set(CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS ON)
