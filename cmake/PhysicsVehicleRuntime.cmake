# Keep the original vehicle controller component independently buildable while
# the live object/body/world ownership graph is still being completed.
add_library(halo2_physics_vehicle_runtime STATIC src/physics/vehicles/physics_vehicle_runtime_generated.cpp)
target_include_directories(halo2_physics_vehicle_runtime PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_physics_vehicle_runtime PUBLIC cxx_std_20)
if(MSVC)
    target_compile_options(halo2_physics_vehicle_runtime PRIVATE /fp:strict)
else()
    target_compile_options(halo2_physics_vehicle_runtime PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
endif()
if(HALO2_SANITIZERS AND NOT MSVC)
    target_compile_options(halo2_physics_vehicle_runtime PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(halo2_physics_vehicle_runtime PUBLIC -fsanitize=address,undefined)
endif()
if(TARGET halo2_systems)
    target_link_libraries(halo2_systems PUBLIC halo2_physics_vehicle_runtime)
endif()
if(BUILD_TESTING)
    add_executable(physics_vehicle_runtime_tests tests/physics_vehicle_runtime_tests.cpp)
    target_link_libraries(physics_vehicle_runtime_tests PRIVATE halo2_physics_vehicle_runtime nlohmann_json::nlohmann_json)
    foreach(image IN ITEMS disc u5)
        add_test(NAME original_physics_vehicle_runtime_${image} COMMAND physics_vehicle_runtime_tests
            ${CMAKE_CURRENT_SOURCE_DIR}/analysis/multiplayer/sandbox-source/vehicle-runtime-20261011/original-verified/${image}.json)
        set_tests_properties(original_physics_vehicle_runtime_${image} PROPERTIES SKIP_RETURN_CODE 77)
    endforeach()
endif()
