# Precompiled runtimes copied from client-source; never download at game launch.
add_library(halo2_upscaling src/rendering/renderer/native_upscaler.cpp src/rendering/renderer/temporal_upscaler.cpp)
target_include_directories(halo2_upscaling PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries(halo2_upscaling PUBLIC Vulkan::Vulkan SDL2::SDL2 halo2_glm nlohmann_json::nlohmann_json)
target_link_libraries(halo2_renderer PUBLIC halo2_upscaling)
target_compile_definitions(halo2_upscaling PRIVATE HALO2_UPSCALER_DIR="${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling")
if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_libraries(halo2_upscaling PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/linux/x64/libnvsdk_ngx.a" ${CMAKE_DL_LIBS})
        target_compile_definitions(halo2_upscaling PRIVATE HALO2_HAS_NGX=1)
    elseif(WIN32 AND MSVC)
        target_link_libraries(halo2_upscaling PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/windows/x64/nvsdk_ngx_s.lib")
        target_compile_definitions(halo2_upscaling PRIVATE HALO2_HAS_NGX=1)
    endif()
endif()
target_include_directories(halo2_upscaling PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/include)
if(BUILD_TESTING)
    add_executable(upscaling_gpu_tests tests/upscaling_gpu_tests.cpp)
    target_link_libraries(upscaling_gpu_tests PRIVATE halo2_upscaling)
    if(UNIX AND NOT APPLE)
        target_compile_definitions(upscaling_gpu_tests PRIVATE HALO2_UPSCALER_IMAGE_OWNERSHIP=1)
        target_link_options(upscaling_gpu_tests PRIVATE -Wl,--wrap=vkCreateImage,--wrap=vkDestroyImage)
    endif()
    add_dependencies(upscaling_gpu_tests halo2_shaders)
    add_test(NAME native_temporal_upscaling COMMAND upscaling_gpu_tests ${CMAKE_CURRENT_BINARY_DIR}/shaders)
    add_test(NAME native_dlss_first_frame COMMAND upscaling_gpu_tests --native-only)
    set_tests_properties(native_dlss_first_frame PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77)
    set_tests_properties(native_temporal_upscaling PROPERTIES TIMEOUT 240)
    if(EXISTS "${CMAKE_SOURCE_DIR}/.tools/validation/usr/share/vulkan/explicit_layer.d/VkLayer_khronos_validation.json")
        set_tests_properties(native_temporal_upscaling native_dlss_first_frame PROPERTIES ENVIRONMENT
            "VK_LAYER_PATH=${CMAKE_SOURCE_DIR}/.tools/validation/usr/share/vulkan/explicit_layer.d;LD_LIBRARY_PATH=${CMAKE_SOURCE_DIR}/.tools/validation/usr/lib:$ENV{LD_LIBRARY_PATH}")
    endif()
endif()
# Executables and packages carry their own copy; no donor-checkout dependency.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(HALO2_UPSCALER_PLATFORM linux/x64)
elseif(WIN32)
    set(HALO2_UPSCALER_PLATFORM windows/x64)
endif()
if(HALO2_UPSCALER_PLATFORM)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/upscalers/${HALO2_UPSCALER_PLATFORM}")
    file(GLOB HALO2_UPSCALER_BINARIES "${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/${HALO2_UPSCALER_PLATFORM}/*.so*"
        "${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/${HALO2_UPSCALER_PLATFORM}/*.dll")
    foreach(binary IN LISTS HALO2_UPSCALER_BINARIES)
        configure_file("${binary}" "${CMAKE_CURRENT_BINARY_DIR}/upscalers/${HALO2_UPSCALER_PLATFORM}/" COPYONLY)
    endforeach()
    foreach(license LICENSE.NVIDIA.txt LICENSE.AMD.txt manifest.json)
        configure_file("${CMAKE_CURRENT_SOURCE_DIR}/external/upscaling/${license}" "${CMAKE_CURRENT_BINARY_DIR}/upscalers/${license}" COPYONLY)
    endforeach()
endif()
