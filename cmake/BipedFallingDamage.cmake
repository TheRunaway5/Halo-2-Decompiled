# Complete paired original falling, airborne and moving-support bodies.
add_library(halo2_biped_falling_damage STATIC src/biped_falling_damage_generated.cpp)
target_include_directories(halo2_biped_falling_damage PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_biped_falling_damage PUBLIC cxx_std_20)
target_sources(halo2_systems PRIVATE src/biped_falling_damage.cpp)
target_link_libraries(halo2_systems PUBLIC halo2_biped_falling_damage)
if(MSVC)
    target_compile_options(halo2_biped_falling_damage PRIVATE /fp:strict)
    set_source_files_properties(src/biped_falling_damage.cpp PROPERTIES COMPILE_OPTIONS /fp:strict)
else()
    target_compile_options(halo2_biped_falling_damage PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
    set_source_files_properties(src/biped_falling_damage.cpp PROPERTIES COMPILE_OPTIONS "-fno-fast-math;-ffp-contract=off;-frounding-math")
endif()
if(HALO2_SANITIZERS AND NOT MSVC)
    target_compile_options(halo2_biped_falling_damage PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(halo2_biped_falling_damage PUBLIC -fsanitize=address,undefined)
endif()
if(BUILD_TESTING)
    add_executable(biped_falling_damage_tests tests/biped_falling_damage_tests.cpp)
    target_link_libraries(biped_falling_damage_tests PRIVATE halo2_systems nlohmann_json::nlohmann_json)
    foreach(image IN ITEMS disc u5)
        add_test(NAME original_biped_falling_damage_${image} COMMAND biped_falling_damage_tests
            ${CMAKE_CURRENT_SOURCE_DIR}/analysis/damage-shields-goal-20261011/falling-producer/original-measured-v4/${image}.json raw)
        set_tests_properties(original_biped_falling_damage_${image} PROPERTIES SKIP_RETURN_CODE 77)
    endforeach()
    add_test(NAME original_biped_falling_damage_joined COMMAND biped_falling_damage_tests
        ${CMAKE_CURRENT_SOURCE_DIR}/analysis/damage-shields-goal-20261011/falling-producer/original-measured-v4/disc.json joined)
    set_tests_properties(original_biped_falling_damage_joined PROPERTIES SKIP_RETURN_CODE 77)
endif()
