# Vendor SDK stays outside source control. Extraction belongs to the caller's
# build tree, including disposable tools/run_tests.py validation trees.
set(HALO2_EOS_SDK_ROOT "" CACHE PATH "Official EOS SDK directory containing Include and Bin")
set(HALO2_EOS_SDK_ARCHIVE "" CACHE FILEPATH "Official EOS SDK zip (optional)")
set(HALO2_EOS_CLIENT_CONFIG "" CACHE FILEPATH "Private input containing shared untrusted game client settings")
if(NOT HALO2_EOS_SDK_ROOT AND NOT HALO2_EOS_SDK_ARCHIVE AND
   EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/EOS-SDK-58105819-Release-v1.19.2.1.zip")
    set(HALO2_EOS_SDK_ARCHIVE "${CMAKE_CURRENT_SOURCE_DIR}/EOS-SDK-58105819-Release-v1.19.2.1.zip")
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|ARM64|arm64)$")
    set(eos_arm TRUE)
endif()
if(APPLE)
    set(eos_binary libEOSSDK-Mac-Shipping.dylib)
elseif(WIN32)
    if(eos_arm)
        set(eos_binary EOSSDK-Win64-Shippingarm64.dll)
        set(eos_import EOSSDK-Win64-Shippingarm64.lib)
    else()
        set(eos_binary EOSSDK-Win64-Shipping.dll)
        set(eos_import EOSSDK-Win64-Shipping.lib)
    endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(eos_arm)
        set(eos_binary libEOSSDK-LinuxArm64-Shipping.so)
    else()
        set(eos_binary libEOSSDK-Linux-Shipping.so)
    endif()
endif()
if(HALO2_EOS_SDK_ARCHIVE AND NOT HALO2_EOS_SDK_ROOT)
    set(eos_extract "${CMAKE_CURRENT_BINARY_DIR}/eos-sdk")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare_eos_sdk.py"
        --archive "${HALO2_EOS_SDK_ARCHIVE}" --output "${eos_extract}"
        --binary "${eos_binary}" --import-library "${eos_import}"
        COMMAND_ERROR_IS_FATAL ANY)
    set(HALO2_EOS_SDK_ROOT "${eos_extract}/SDK")
endif()
if(HALO2_EOS_SDK_ROOT)
    if(NOT eos_binary OR NOT EXISTS "${HALO2_EOS_SDK_ROOT}/Include/eos_sdk.h" OR
       NOT EXISTS "${HALO2_EOS_SDK_ROOT}/Bin/${eos_binary}")
        message(FATAL_ERROR "EOS SDK headers or host library are missing")
    endif()
    add_library(halo2_eos_sdk SHARED IMPORTED GLOBAL)
    set_target_properties(halo2_eos_sdk PROPERTIES IMPORTED_LOCATION "${HALO2_EOS_SDK_ROOT}/Bin/${eos_binary}")
    if(WIN32)
        set_target_properties(halo2_eos_sdk PROPERTIES IMPORTED_IMPLIB "${HALO2_EOS_SDK_ROOT}/Lib/${eos_import}")
    endif()
endif()
function(halo2_bundle_eos target)
    if(HALO2_EOS_CLIENT_CONFIG AND NOT TARGET halo2_eos_sdk)
        message(FATAL_ERROR "Packaged EOS client settings require the official SDK")
    endif()
    if(TARGET halo2_eos_sdk)
        add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "$<TARGET_FILE:halo2_eos_sdk>" "$<TARGET_FILE_DIR:${target}>/$<TARGET_FILE_NAME:halo2_eos_sdk>" VERBATIM)
        if(HALO2_EOS_CLIENT_CONFIG)
            set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${HALO2_EOS_CLIENT_CONFIG}")
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/package_eos_client.py"
                    --source "${HALO2_EOS_CLIENT_CONFIG}" --output "$<TARGET_FILE_DIR:${target}>/eos-client.env"
                VERBATIM)
        endif()
        if(UNIX AND NOT APPLE)
            set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "$ORIGIN")
            set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
        elseif(APPLE)
            set_property(TARGET ${target} APPEND PROPERTY BUILD_RPATH "@loader_path")
            set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH "@loader_path")
        endif()
    endif()
endfunction()
