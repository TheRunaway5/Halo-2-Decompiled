add_library(halo2_source_vitality STATIC src/gameplay/units/source_vitality_runtime_generated.cpp)
target_include_directories(halo2_source_vitality PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_source_vitality PUBLIC cxx_std_20)
target_link_libraries(halo2_systems PUBLIC halo2_source_vitality)
if(MSVC)
    target_compile_options(halo2_source_vitality PRIVATE /fp:strict)
else()
    target_compile_options(halo2_source_vitality PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
endif()
if(HALO2_SANITIZERS AND NOT MSVC)
    target_compile_options(halo2_source_vitality PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(halo2_source_vitality PUBLIC -fsanitize=address,undefined)
endif()
if(BUILD_TESTING)
    add_executable(source_vitality_runtime_tests tests/source_vitality_runtime_tests.cpp)
    target_link_libraries(source_vitality_runtime_tests PRIVATE halo2_source_vitality nlohmann_json::nlohmann_json)
    foreach(image IN ITEMS disc u5)
        add_test(NAME original_source_vitality_${image} COMMAND source_vitality_runtime_tests
            ${CMAKE_CURRENT_SOURCE_DIR}/analysis/damage-shields-goal-20261011/vitality-runtime/original-v5/${image}.json)
        set_tests_properties(original_source_vitality_${image} PROPERTIES SKIP_RETURN_CODE 77)
    endforeach()
endif()
