# CTest owns per-invocation scratch. Test executables are built explicitly so
# a normal game build does not link thousands of copies of the engine.
include_guard(GLOBAL)
option(HALO2_TESTS_IN_ALL "Include test executables in the default build" OFF)
set(_HALO2_TEST_RUNNER "${CMAKE_CURRENT_LIST_DIR}/../tools/run_test.py")

function(halo2_quote_test_argument result value)
    set(delimiter "=")
    while(value MATCHES "]${delimiter}]")
        string(APPEND delimiter "=")
    endwhile()
    set(${result} "[${delimiter}[${value}]${delimiter}]" PARENT_SCOPE)
endfunction()

function(add_test)
    set(command_index -1)
    math(EXPR last "${ARGC} - 1")
    foreach(index RANGE ${last})
        if("${ARGV${index}}" STREQUAL "COMMAND")
            set(command_index ${index})
            break()
        endif()
    endforeach()
    if(NOT command_index GREATER 0 OR NOT ARGV0 STREQUAL "NAME")
        message(FATAL_ERROR "Use add_test(NAME ... COMMAND ...) for managed test storage")
    endif()
    math(EXPR executable_index "${command_index} + 1")
    set(executable "${ARGV${executable_index}}")
    # Keep CMake's executable-target lookup (and cross-compiling emulator)
    # when inserting the Python supervisor in front of the original command.
    if(TARGET "${executable}")
        get_target_property(emulator "${executable}" CROSSCOMPILING_EMULATOR)
        get_target_property(target_type "${executable}" TYPE)
        if(target_type STREQUAL "EXECUTABLE")
            set_property(GLOBAL APPEND PROPERTY HALO2_TEST_BUILD_TARGETS "${executable}")
        endif()
        set(executable "$<TARGET_FILE:${executable}>")
    endif()
    # Python fixtures often receive additional executable targets as arguments.
    foreach(index RANGE ${last})
        set(argument "${ARGV${index}}")
        if(argument MATCHES "^\\$<TARGET_FILE:([^>]+)>$")
            set_property(GLOBAL APPEND PROPERTY HALO2_TEST_BUILD_TARGETS "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    # Quote each original argv separately: CMake list expansion would split
    # literal semicolons and lose empty arguments in existing test commands.
    set(invocation "_add_test(")
    foreach(index RANGE ${last})
        set(argument "${ARGV${index}}")
        if(index EQUAL executable_index)
            foreach(prefix "${Python3_EXECUTABLE}" "${_HALO2_TEST_RUNNER}"
                    --scratch-root "${CMAKE_BINARY_DIR}/Testing/Temporary/scratch" --)
                halo2_quote_test_argument(quoted "${prefix}")
                string(APPEND invocation " ${quoted}")
            endforeach()
            if(emulator)
                foreach(prefix IN LISTS emulator)
                    halo2_quote_test_argument(quoted "${prefix}")
                    string(APPEND invocation " ${quoted}")
                endforeach()
            endif()
            set(argument "${executable}")
        endif()
        halo2_quote_test_argument(quoted "${argument}")
        string(APPEND invocation " ${quoted}")
    endforeach()
    cmake_language(EVAL CODE "${invocation})")
endfunction()

function(halo2_finalize_test_storage)
    if(HALO2_SECURITY_LIBRARY)
        get_property(security_tests DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY TESTS)
        foreach(test IN LISTS security_tests)
            set_property(TEST "${test}" APPEND PROPERTY ENVIRONMENT "H2_SECURITY_LIBRARY=${HALO2_SECURITY_LIBRARY}")
        endforeach()
    endif()
    get_property(targets GLOBAL PROPERTY HALO2_TEST_BUILD_TARGETS)
    # Include unregistered test helpers too; several are executable arguments
    # of Python tests or are used only by an explicitly invoked validator.
    halo2_collect_test_targets("${CMAKE_SOURCE_DIR}")
    get_property(extra_targets GLOBAL PROPERTY HALO2_TEST_SOURCE_TARGETS)
    list(APPEND targets ${extra_targets})
    if(targets)
        list(REMOVE_DUPLICATES targets)
    endif()
    add_custom_target(halo2_tests DEPENDS ${targets})
endfunction()

function(halo2_collect_test_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(target_type "${target}" TYPE)
        if(target_type STREQUAL "EXECUTABLE")
            get_target_property(sources "${target}" SOURCES)
            if(sources MATCHES "(^|[;/])tests/" OR target MATCHES "(_tests|_test)$")
                if(NOT HALO2_TESTS_IN_ALL)
                    set_property(TARGET "${target}" PROPERTY EXCLUDE_FROM_ALL TRUE)
                endif()
                set_property(GLOBAL APPEND PROPERTY HALO2_TEST_SOURCE_TARGETS "${target}")
            endif()
        endif()
    endforeach()
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        halo2_collect_test_targets("${subdirectory}")
    endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL halo2_finalize_test_storage)
