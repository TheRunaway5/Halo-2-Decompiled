# TU1.5-only contact-state delivery and reference-release composition.
add_library(halo2_physics_vehicle_contact_state STATIC src/physics/vehicles/physics_vehicle_contact_state_tu15_generated.cpp)
target_include_directories(halo2_physics_vehicle_contact_state PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_physics_vehicle_contact_state PUBLIC cxx_std_20)
target_link_libraries(halo2_physics_vehicle_contact_state PUBLIC halo2_physics_vehicle_motion_math)
if(MSVC)
    target_compile_options(halo2_physics_vehicle_contact_state PRIVATE /fp:strict)
else()
