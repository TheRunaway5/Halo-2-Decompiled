include_guard(GLOBAL)
function(halo2_mcc_decompression target)
    option(HALO2_USE_LIBDEFLATE "Use runtime CPU dispatch for MCC map decompression" ON)
    if(NOT HALO2_USE_LIBDEFLATE)
        return()
    endif()
    if(APPLE)
        option(HALO2_MACOS_BUILD_LIBDEFLATE "Build pinned libdeflate for the requested Mac architectures" ON)
    endif()
    if(APPLE AND HALO2_MACOS_BUILD_LIBDEFLATE)
        include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/macos/Libdeflate.cmake")
        halo2_macos_libdeflate_dependency()
        set(HALO2_MACOS_ENGINE_LICENSES ${HALO2_MACOS_ENGINE_LICENSES} PARENT_SCOPE)
    else()
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(LIBDEFLATE QUIET IMPORTED_TARGET libdeflate>=1.9)
    endif()
    if(TARGET PkgConfig::LIBDEFLATE)
        target_link_libraries(${target} PRIVATE PkgConfig::LIBDEFLATE)
        target_compile_definitions(${target} PRIVATE HALO2_HAVE_LIBDEFLATE=1)
    endif()
endfunction()
