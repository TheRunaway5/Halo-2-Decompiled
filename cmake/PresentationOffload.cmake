find_package(Threads REQUIRED)
target_sources(halo2_renderer PRIVATE src/rendering/renderer/presentation_copy_worker.cpp)
target_link_libraries(halo2_renderer PRIVATE Threads::Threads)
if(BUILD_TESTING)
    add_executable(presentation_copy_worker_tests tests/presentation_copy_worker_tests.cpp
        src/rendering/renderer/presentation_copy_worker.cpp)
    target_include_directories(presentation_copy_worker_tests PRIVATE include src)
    target_compile_features(presentation_copy_worker_tests PRIVATE cxx_std_20)
    target_link_libraries(presentation_copy_worker_tests PRIVATE Threads::Threads)
    if(HALO2_SANITIZERS AND NOT MSVC)
        target_compile_options(presentation_copy_worker_tests PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(presentation_copy_worker_tests PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME native_presentation_copy_worker COMMAND presentation_copy_worker_tests)
    set_tests_properties(native_presentation_copy_worker PROPERTIES TIMEOUT 60)
endif()
