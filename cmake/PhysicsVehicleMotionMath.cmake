# Compose source CRT remainder, FP-control and vehicle solver dispatch owners.
add_library(halo2_physics_vehicle_motion_math STATIC src/physics/vehicles/physics_vehicle_motion_math_generated.cpp)
target_include_directories(halo2_physics_vehicle_motion_math PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_physics_vehicle_motion_math PUBLIC cxx_std_20)
target_link_libraries(halo2_physics_vehicle_motion_math PUBLIC halo2_physics_vehicle_motion)
if(MSVC)
    target_compile_options(halo2_physics_vehicle_motion_math PRIVATE /fp:strict)
else()
    target_compile_options(halo2_physics_vehicle_motion_math PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
endif()
if(HALO2_SANITIZERS AND NOT MSVC)
    target_compile_options(halo2_physics_vehicle_motion_math PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(halo2_physics_vehicle_motion_math PUBLIC -fsanitize=address,undefined)
endif()
if(TARGET halo2_systems)
    target_link_libraries(halo2_systems PUBLIC halo2_physics_vehicle_motion_math)
endif()
if(BUILD_TESTING)
    add_executable(physics_vehicle_motion_math_tests tests/physics_vehicle_motion_math_tests.cpp)
    target_link_libraries(physics_vehicle_motion_math_tests PRIVATE halo2_physics_vehicle_motion_math nlohmann_json::nlohmann_json)
    foreach(image IN ITEMS u5)
        add_test(NAME original_physics_vehicle_motion_math_${image} COMMAND physics_vehicle_motion_math_tests
            ${CMAKE_CURRENT_SOURCE_DIR}/analysis/multiplayer/sandbox-source/vehicle-motion-math-20261011/hardware-verified/${image}-native.json)
        set_tests_properties(original_physics_vehicle_motion_math_${image} PROPERTIES SKIP_RETURN_CODE 77)
    endforeach()
endif()
