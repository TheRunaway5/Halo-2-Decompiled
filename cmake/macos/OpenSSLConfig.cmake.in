# Build-tree package redirect for dependencies that call find_package(OpenSSL)
# before the owned SDK has been compiled. Imported targets already describe
# its actual generated outputs; no host header or library is substituted.
if(NOT TARGET OpenSSL::Crypto OR NOT TARGET OpenSSL::SSL)
    set(OpenSSL_FOUND FALSE)
    set(OpenSSL_NOT_FOUND_MESSAGE "The macOS OpenSSL SDK targets are unavailable")
    return()
endif()
set(OpenSSL_FOUND TRUE)
set(OPENSSL_FOUND TRUE)
set(OpenSSL_VERSION "3.5.9")
set(OPENSSL_VERSION "3.5.9")
set(OPENSSL_INCLUDE_DIR "@prefix@/include")
set(OPENSSL_CRYPTO_LIBRARY "@prefix@/lib/libcrypto.3.dylib")
set(OPENSSL_SSL_LIBRARY "@prefix@/lib/libssl.3.dylib")
set(OPENSSL_LIBRARIES "${OPENSSL_SSL_LIBRARY};${OPENSSL_CRYPTO_LIBRARY}")
foreach(component IN LISTS OpenSSL_FIND_COMPONENTS)
    if(component STREQUAL "Crypto" OR component STREQUAL "SSL")
        set(OpenSSL_${component}_FOUND TRUE)
    else()
        set(OpenSSL_${component}_FOUND FALSE)
        if(OpenSSL_FIND_REQUIRED_${component})
            set(OpenSSL_FOUND FALSE)
            set(OpenSSL_NOT_FOUND_MESSAGE "Unsupported OpenSSL component: ${component}")
        endif()
    endif()
endforeach()
