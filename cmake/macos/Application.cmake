include_guard(GLOBAL)
enable_language(OBJCXX)
find_library(HALO2_FOUNDATION_FRAMEWORK Foundation REQUIRED)
get_filename_component(_halo2_application_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
add_library(halo2_macos_application STATIC "${_halo2_application_root}/src/macos/application.mm")
set_target_properties(halo2_macos_application PROPERTIES OBJCXX_STANDARD 20 OBJCXX_STANDARD_REQUIRED YES)
target_include_directories(halo2_macos_application PUBLIC "${_halo2_application_root}/include")
target_link_libraries(halo2_macos_application PRIVATE "${HALO2_FOUNDATION_FRAMEWORK}")
function(halo2_macos_application target)
    target_link_libraries(${target} PRIVATE halo2_macos_application)
endfunction()
