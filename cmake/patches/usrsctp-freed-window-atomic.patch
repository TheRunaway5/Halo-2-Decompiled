+/* Native peer transport: this advisory counter crosses sockbuf and TCB
+ * lock domains. Keep every userspace access atomic without changing layout.
+ * Its value publishes no other association state, so relaxed ordering suffices.
+ */
+static inline uint32_t
+sctp_freed_bytes_take(struct sctp_tcb *stcb)
+{
+#if defined(__Userspace__) && (defined(__GNUC__) || defined(__clang__))
+	return __atomic_exchange_n(&stcb->freed_by_sorcv_sincelast, 0, __ATOMIC_RELAXED);
+#elif defined(__Userspace__) && defined(_WIN32)
+	return (uint32_t)InterlockedExchange((volatile LONG *)&stcb->freed_by_sorcv_sincelast, 0);
+#else
+	uint32_t previous = stcb->freed_by_sorcv_sincelast;
+	stcb->freed_by_sorcv_sincelast = 0;
+	return previous;
+#endif
+}
+
+static inline void
+sctp_freed_bytes_set(struct sctp_tcb *stcb, uint32_t value)
+{
+#if defined(__Userspace__) && (defined(__GNUC__) || defined(__clang__))
+	__atomic_store_n(&stcb->freed_by_sorcv_sincelast, value, __ATOMIC_RELAXED);
+#elif defined(__Userspace__) && defined(_WIN32)
+	(void)InterlockedExchange((volatile LONG *)&stcb->freed_by_sorcv_sincelast, (LONG)value);
+#else
+	stcb->freed_by_sorcv_sincelast = value;
+#endif
+}
+
