+int
+sctp_os_timer_flags(sctp_os_timer_t *c, int clear_flags)
+{
+	int flags;
+
+	SCTP_TIMERQ_LOCK();
+	if (clear_flags) {
+		c->c_flags &= ~clear_flags;
+	}
+	flags = c->c_flags;
+	SCTP_TIMERQ_UNLOCK();
+	return flags;
+}
