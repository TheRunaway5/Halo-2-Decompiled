include_guard(GLOBAL)

function(halo2_add_online_protocol)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    find_package(Threads REQUIRED)
    find_program(HALO2_ONLINE_CARGO cargo REQUIRED)
    find_program(HALO2_ONLINE_RUSTC rustc REQUIRED)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/EosSdk.cmake")
    set(HALO2_ONLINE_RUST_TOOLCHAIN "1.96.0" CACHE STRING
        "Installed toolchain name; its actual rustc must match the pinned 1.96.0")
    option(HALO2_ONLINE_RUST_OFFLINE "Use only cached locked Rust dependencies" OFF)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(module "${root}/rust/online_protocol_bridge")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/online-protocol/$<CONFIG>")
    set(archive "${CMAKE_STATIC_LIBRARY_PREFIX}halo2_online_protocol_bridge${CMAKE_STATIC_LIBRARY_SUFFIX}")
    set(rust_cxx_flags "${CMAKE_CXX_FLAGS}")
    if(HALO2_SANITIZERS AND NOT MSVC)
        string(APPEND rust_cxx_flags " -fsanitize=address,undefined -fno-omit-frame-pointer")
    endif()
    set(arguments --manifest "${module}/Cargo.toml" --output "${output}"
        --cargo "${HALO2_ONLINE_CARGO}" --rustc "${HALO2_ONLINE_RUSTC}"
        --toolchain "${HALO2_ONLINE_RUST_TOOLCHAIN}" --cxx "${CMAKE_CXX_COMPILER}"
        "--cxx-flags=${rust_cxx_flags}" --library-name "${archive}")
    if(HALO2_EOS_SDK_ROOT)
        list(APPEND arguments --eos-sdk-root "${HALO2_EOS_SDK_ROOT}")
    endif()
    if(APPLE)
        set(architectures "${CMAKE_OSX_ARCHITECTURES}")
        if(NOT architectures)
            set(architectures "${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        foreach(architecture IN LISTS architectures)
            if(architecture STREQUAL "arm64" OR architecture STREQUAL "aarch64")
                list(APPEND arguments --target aarch64-apple-darwin)
            elseif(architecture STREQUAL "x86_64")
                list(APPEND arguments --target x86_64-apple-darwin)
            else()
                message(FATAL_ERROR "Unsupported ONLINE Rust macOS architecture: ${architecture}")
            endif()
        endforeach()
        if(CMAKE_OSX_DEPLOYMENT_TARGET)
            list(APPEND arguments --deployment-target "${CMAKE_OSX_DEPLOYMENT_TARGET}")
        endif()
        if(CMAKE_OSX_SYSROOT)
            list(APPEND arguments --sysroot "${CMAKE_OSX_SYSROOT}")
        endif()
    else()
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
            set(architecture x86_64)
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|ARM64|arm64)$")
            set(architecture aarch64)
        else()
            message(FATAL_ERROR "Unsupported ONLINE Rust architecture: ${CMAKE_SYSTEM_PROCESSOR}")
        endif()
        if(WIN32 AND MSVC)
            set(triple "${architecture}-pc-windows-msvc")
        elseif(WIN32)
            set(triple "${architecture}-pc-windows-gnu")
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set(triple "${architecture}-unknown-linux-gnu")
        else()
            message(FATAL_ERROR "Unsupported ONLINE Rust platform: ${CMAKE_SYSTEM_NAME}")
        endif()
        list(APPEND arguments --target "${triple}")
    endif()
    if(HALO2_ONLINE_RUST_OFFLINE)
        list(APPEND arguments --offline)
    endif()
    file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${module}/src/*.rs"
        "${root}/rust/online_protocol/src/*.rs")
    list(APPEND inputs "${module}/Cargo.toml" "${module}/Cargo.lock" "${module}/build.rs"
        "${module}/src/eos_sdk.hpp" "${module}/src/eos_sdk.cpp"
        "${module}/rust-toolchain.toml" "${root}/rust/online_protocol/Cargo.toml"
        "${root}/rust/online_protocol/rust-toolchain.toml"
        "${root}/tools/build_online_protocol_rust.py")
    add_custom_command(OUTPUT "${output}/${archive}" "${output}/native-libs.rsp"
        "${output}/include/halo2-online-protocol-bridge/src/lib.rs.h"
        "${output}/include/rust/cxx.h" "${output}/build-report.json"
        COMMAND "${Python3_EXECUTABLE}" "${root}/tools/build_online_protocol_rust.py" ${arguments}
        DEPENDS ${inputs} VERBATIM USES_TERMINAL)
    add_custom_target(halo2_online_protocol_rust_build DEPENDS "${output}/${archive}"
        "${output}/include/halo2-online-protocol-bridge/src/lib.rs.h"
        "${output}/include/rust/cxx.h" "${output}/native-libs.rsp")
    add_library(halo2_online_protocol_rust STATIC IMPORTED GLOBAL)
    set_target_properties(halo2_online_protocol_rust PROPERTIES IMPORTED_LOCATION "${output}/${archive}")
    # Imported locations do not evaluate configuration expressions themselves.
    foreach(config Debug Release RelWithDebInfo MinSizeRel)
        string(TOUPPER "${config}" upper)
        set_property(TARGET halo2_online_protocol_rust PROPERTY "IMPORTED_LOCATION_${upper}"
            "${CMAKE_CURRENT_BINARY_DIR}/online-protocol/${config}/${archive}")
    endforeach()
    add_dependencies(halo2_online_protocol_rust halo2_online_protocol_rust_build)
    add_library(halo2_online_protocol STATIC "${root}/src/network/online_voice_protocol.cpp"
        "${root}/src/platform/native_request_protocol.cpp" "${root}/src/runtime/authority_archive_protocol.cpp")
    add_dependencies(halo2_online_protocol halo2_online_protocol_rust_build)
    target_compile_features(halo2_online_protocol PUBLIC cxx_std_20)
    target_include_directories(halo2_online_protocol PUBLIC "${root}/include"
        PRIVATE "${output}/include" "${module}")
    target_link_libraries(halo2_online_protocol PRIVATE halo2_online_protocol_rust Threads::Threads)
    if(TARGET halo2_eos_sdk)
        target_link_libraries(halo2_online_protocol PRIVATE halo2_eos_sdk)
    endif()
    # Expose the generated bridge to the thin native transport adapter only.
    set(HALO2_ONLINE_BRIDGE_INCLUDE "${output}/include" PARENT_SCOPE)
    if(MSVC)
        target_link_options(halo2_online_protocol INTERFACE "@${output}/native-libs.rsp")
    else()
        # Place native dependencies after the Rust archive for --as-needed.
        target_link_libraries(halo2_online_protocol PRIVATE "-Wl$<COMMA>@${output}/native-libs.rsp")
    endif()
    if(HALO2_SANITIZERS AND NOT MSVC)
        target_compile_options(halo2_online_protocol PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(halo2_online_protocol PUBLIC -fsanitize=address,undefined)
    endif()
    if(BUILD_TESTING)
        add_executable(online_voice_protocol_tests "${root}/tests/online_voice_protocol_tests.cpp")
        target_link_libraries(online_voice_protocol_tests PRIVATE halo2_online_protocol Threads::Threads)
        add_test(NAME online_voice_protocol COMMAND online_voice_protocol_tests)
        set_tests_properties(online_voice_protocol PROPERTIES TIMEOUT 30)
        add_executable(native_request_protocol_tests "${root}/tests/native_request_protocol_tests.cpp")
        target_link_libraries(native_request_protocol_tests PRIVATE halo2_online_protocol Threads::Threads)
        add_test(NAME native_request_protocol COMMAND native_request_protocol_tests)
        set_tests_properties(native_request_protocol PROPERTIES TIMEOUT 90)
        add_executable(authority_archive_protocol_tests "${root}/tests/authority_archive_protocol_tests.cpp")
        target_link_libraries(authority_archive_protocol_tests PRIVATE halo2_online_protocol Threads::Threads)
        add_test(NAME authority_archive_protocol COMMAND authority_archive_protocol_tests)
        set_tests_properties(authority_archive_protocol PROPERTIES TIMEOUT 90)
    endif()
endfunction()

halo2_add_online_protocol()
