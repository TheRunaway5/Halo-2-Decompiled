# Replay the existing physical-original cases through each complete caller.
foreach(driver selector dispatch_strict location_strict lifecycle_strict initialization audio_request_strict zoom_reset_strict)
    set(prefix native_weapon_effect)
    if(driver MATCHES "^(audio_request|zoom_reset)")
        set(prefix native_weapon)
    endif()
    set(target native_weapon_effect_${driver}_compiled_routes_tu15_tests)
    add_executable(${target} tests/${prefix}_${driver}_tu15_tests.cpp)
    target_compile_features(${target} PRIVATE cxx_std_20)
    target_compile_definitions(${target} PRIVATE HALO2_NATIVE_EFFECT_COMPILED_ROUTE=1)
    target_include_directories(${target} PRIVATE tests)
    target_link_libraries(${target} PRIVATE halo2_systems nlohmann_json::nlohmann_json)
    if(HALO2_SANITIZERS AND NOT MSVC)
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    endif()
endforeach()
function(halo2_native_effect_compiled_route module entry driver fixture)
    add_test(NAME native_weapon_effect_route_${module}_${entry}_tu15
        COMMAND native_weapon_effect_${driver}_compiled_routes_tu15_tests
        "${PROJECT_SOURCE_DIR}/tests/fixtures/${fixture}" "${module}" "${entry}")
    set_tests_properties(native_weapon_effect_route_${module}_${entry}_tu15 PROPERTIES TIMEOUT 180)
endfunction()
