# Original scalar vehicle controls remain separate from the unfinished live
# driving/body integration. Build this component with strict FP semantics.
add_library(halo2_vehicle_control STATIC src/gameplay/vehicles/source_vehicle_control.cpp)
target_include_directories(halo2_vehicle_control PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(halo2_vehicle_control PUBLIC cxx_std_20)
if(MSVC)
    target_compile_options(halo2_vehicle_control PRIVATE /fp:strict)
else()
    target_compile_options(halo2_vehicle_control PRIVATE -fno-fast-math -ffp-contract=off -frounding-math)
endif()
if(HALO2_SANITIZERS AND NOT MSVC)
    target_compile_options(halo2_vehicle_control PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(halo2_vehicle_control PUBLIC -fsanitize=address,undefined)
endif()
if(TARGET halo2_systems)
    target_link_libraries(halo2_systems PUBLIC halo2_vehicle_control)
endif()
if(BUILD_TESTING)
    add_executable(source_vehicle_control_tests tests/source_vehicle_control_tests.cpp)
    target_link_libraries(source_vehicle_control_tests PRIVATE halo2_vehicle_control nlohmann_json::nlohmann_json)
    add_test(NAME original_source_vehicle_control COMMAND source_vehicle_control_tests
        ${CMAKE_CURRENT_SOURCE_DIR}/analysis/multiplayer/sandbox-source/vehicle-control-20261011/original-verified/fixture.json)
    set_tests_properties(original_source_vehicle_control PROPERTIES SKIP_RETURN_CODE 77)
endif()
