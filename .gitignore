# Builds, downloaded tools/references, and local analysis workspaces.
# Launcher-selected engine builds stay local, including their runtime resources.
/bin/engine-builds/
/build*/
/cmake-build*/
/out/
/dist/
/.tools/
/analysis/
/work/
/tools/reference/*
# Authored conversion policies contain identities, shapes and audit hashes;
# downloaded reference trees and extracted payloads remain local.
!/tools/reference/mcc-native-library-closure.json
!/tools/reference/mcc-native-template-variants.json
!/tools/reference/mcc-tex-bump-unanimated.json
/.ark-*/
CMakeFiles/
CMakeCache.txt
Testing/
compile_commands.json
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.spv

# Installed launcher copies and generated desktop shortcuts.
# Reusable launcher sources and installation scripts live in src/ and tools/.
/Halo2-*
!/Halo2-Launcher
/Halo 2 Native*.desktop

# Local keys, credentials, service databases, and Python environments/caches.
.local/
.env
.env.*
!.env.example
!.env.sample
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Runtime caches, logs, editor backups, and desktop metadata.
*.dxvk-cache
*.log
/launcher-update.pending
# Local selections bind validated runtime files in this checkout.
/runtime-selection.json
/frontend-runtime-selection.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Authored custom Slayer release definitions are shipped with the repository.
!releases/halo2-custom-slayer-*.zip

# Rebuildable, verified lossless playback payload; keep its small receipt.
/resources/movie-playback/*.mp4

# Requested precompiled temporal-upscaling runtimes and NGX link inputs.
!external/upscaling/**/*.so*
!external/upscaling/**/*.a
!external/upscaling/**/*.dll
!external/upscaling/**/*.lib
