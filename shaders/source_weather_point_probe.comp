#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
struct Fixture {uvec4 instructions[136];vec4 camera[12];uvec4 flags;vec4 position;uvec4 color;};
layout(set=0,binding=0,std430) readonly buffer Inputs {Fixture fixtures[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {vec4 results[];};
Fixture weather;
#include "source_weather_point_program.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;weather=fixtures[i];
    sourceWeatherPointProgram(weather.position,weather.color.x);
    for(uint o=0u;o<16u;++o)results[i*16u+o]=vpOut[o];
}
