#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
struct Fixture {
    uvec4 instructions[136];vec4 attributes[16];uvec4 flags;
    vec4 constants[192];vec4 streams[10];uvec4 declaration;
};
layout(set=0,binding=0,std430) readonly buffer Inputs {Fixture fixtures[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {vec4 results[];};
struct MaterialData {uvec4 vertexInstructions[136];vec4 vertexAttributes[16];uvec4 flags;uvec4 vertexDeclaration;};
MaterialData material;
struct VertexBankData {uvec4 range;};
VertexBankData vertexBank;
uint fixtureIndex;
vec3 position,normal,tangent,binormal,incident,radiance;
vec2 texcoord,lightmapCoord;
float prtCluster;
float sourceColorAlpha;
vec4 prtWeights;
#define H2_VERTEX_REFERENCE_CONSTANTS
#define H2_EXTENDED_VERTEX_BANK
#define H2_SOURCE_VERTEX_DECLARATION
#define H2_SOURCE_IMMEDIATE_COLOR11
#define RETAIL_VERTEX_RADIANCE radiance
vec4 vpConstant(uint index){return fixtures[fixtureIndex].constants[index];}
// Deliberately no H2_VERTEX_REFERENCE_INPUTS: production register mapping
// must consume the decoded streams and retained declaration selectors.
#include "vertex_program.glsl"
void main() {
    fixtureIndex=gl_GlobalInvocationID.x;
    for(uint i=0u;i<136u;++i)material.vertexInstructions[i]=fixtures[fixtureIndex].instructions[i];
    for(uint i=0u;i<16u;++i)material.vertexAttributes[i]=fixtures[fixtureIndex].attributes[i];
    material.flags=fixtures[fixtureIndex].flags;
    material.vertexDeclaration=fixtures[fixtureIndex].declaration;
    vertexBank.range=uvec4(0,0,material.flags.z==9u?1u:0u,0);
    position=fixtures[fixtureIndex].streams[0].xyz;texcoord=fixtures[fixtureIndex].streams[1].xy;
    normal=fixtures[fixtureIndex].streams[2].xyz;tangent=fixtures[fixtureIndex].streams[3].xyz;
    binormal=fixtures[fixtureIndex].streams[4].xyz;incident=fixtures[fixtureIndex].streams[5].xyz;
    lightmapCoord=fixtures[fixtureIndex].streams[6].xy;radiance=fixtures[fixtureIndex].streams[7].xyz;
    sourceColorAlpha=fixtures[fixtureIndex].streams[7].w;
    prtCluster=fixtures[fixtureIndex].streams[8].x;prtWeights=fixtures[fixtureIndex].streams[9];
    runVertexProgram();
    for(uint i=0u;i<16u;++i){results[fixtureIndex*32u+i]=vpInput[i];results[fixtureIndex*32u+16u+i]=vpOut[i];}
}
