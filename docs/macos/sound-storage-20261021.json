  "diagnosis": {
    "symptom": "Native arm64 rejected retained physical alias 0x82e45000 / extent 0x300000 before OS allocation; Rosetta and Linux accepted it.",
    "paired_control": "Native arm64 accepted otherwise identical 3 MiB backing at 0x82e44000; rejected 0x82e45000. Only alias alignment changed.",
    "cause": "Private alias validation, allocation rounding and protection alignment incorrectly used the host OS page size.",
    "correction": "Keep 4 KiB private logical intervals, cursor increments and exposed bounds; independently round each real OS backing extent and read/write operation to host pages.",
    "host_page_size_api": "page_size() remains the actual OS page size; alias_page_size() reports 4096.",
    "protection_scope": "Only mode4 read/write; rounding remains inside one owned mapping. Other source-page permissions are not implemented."
  },
