H2_MASTER_STATE=.local/master-a
H2_MASTER_BIND=127.0.0.1
H2_MASTER_PORT=18081
H2_MASTER_PUBLIC_URL=http://127.0.0.1:18081
# Local development only. Public deployments require TLS.
H2_MASTER_ALLOW_HTTP=1
H2_MASTER_ADMIN_TOKEN_FILE=.local/master-a/admin-token
H2_MASTER_PEERS_FILE=.local/master-a/peers.json
H2_MASTER_LEASE_SECONDS=90
H2_MASTER_SYNC_SECONDS=15
H2_MASTER_RATE_PER_MINUTE=600
H2_DISCORD_CLIENT_ID=1558522073272426519

# Optional authenticated matchmaking. Supply an explicitly sourced catalog.
# H2_MATCHMAKING_CATALOG=/absolute/path/to/playlists.json
