  "result": "All three findings patched in local source; no production deployment or Security Cloud rescan.",
  "findings": [
    {
      "id": "csf_e563eaf3d5bb25ee52ec970e",
      "title": "MCC import can follow nested links or swapped directories outside the selected donor",
      "fix": [
        "Shared DonorTree pins each POSIX directory with openat/O_NOFOLLOW and reads the admitted file descriptor.",
        "Windows rejects reparse points on opened handles and retains every ancestor without write/delete sharing before pathname enumeration or child opens.",
        "Inventory/copy validate device/inode ownership and source metadata; MCC and Vista directory imports use the same helper.",
        "Copied files use POSIX 0600 or a protected Windows DACL granting the importing user SID and SYSTEM. Vista archive outputs use the same private writer."
      ],
      "before_fix": [
        "Directory-swap regression enumerated outside secret.bin.",
        "Final-file replacement wrote replacement bytes before rejecting the source change.",
        "Permissive umask produced mode 0666 instead of 0600."
      ]
    },
    {
      "id": "csf_015abbaa0b3a8d1d666e6113",
      "title": "Rotating source addresses can exhaust all pending Steam login slots",
      "fix": [
        "Four unverified entries per exact source, eight per source prefix, 128 anonymous entries globally.",
        "Failed/cancelled unverified entries remain anonymous for quota purposes.",
        "Anonymous starts have a separate 16-request burst and 60/minute refill.",
        "Anonymous state cannot occupy the remaining provider-verified/completing reserve in the 1000-entry bank."
      ],
      "before_fix": "After one verified flow, 999 rotating addresses consumed the remaining shared pending slots."
    },
    {
      "id": "csf_526b38cc8d16b01f3f27096f",
      "title": "IPv6 source rotation can pin the shared rate limiter and block new clients",
      "fix": [
        "Separate O(1) LRU tables for exact sources, prefixes, principals, anonymous devices, pinned peers, and global controls.",
        "At capacity, evict one oldest bucket instead of rejecting all unseen sources or scanning all entries.",
        "Default IPv6 /64 prefix allowance: 1200/minute, 512 initial requests; IPv4-mapped addresses normalize into IPv4 accounting.",
        "Independent service allowance: 6000/minute, 2048 initial requests, 64 concurrent HTTP handlers.",
        "Upgraded WebSockets release HTTP slots; aggregate limiter metrics contain no client addresses."
      ],
      "before_fix": "4096 recent exact-source keys caused a new legitimate IP and its principal to fail before routing."
    }
  ],
