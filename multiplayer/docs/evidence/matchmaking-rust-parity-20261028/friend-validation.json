    },
    {
      "trigger": "Run an actual friend command inside an outer SQL transaction, then roll back.",
      "before": "The endpoint commits the caller transaction.",
      "after": "The outer transaction stays open; rollback removes the command and block."
    },
    {
      "trigger": "Revoke the actual native account during the presence provider callback.",
      "before": "HTTP200 after mutation/replay commit.",
      "after": "HTTP401 and rollback of friendship, replay and both friend-file outbox rows."
    },
    {
      "trigger": "Observe SQL transaction state inside the actual friend cloud upload callback.",
      "before": "Selection leaves a SQL transaction open across SDK IO.",
      "after": "Selection commits before upload."
    },
    {
      "trigger": "Enqueue an uncommitted outer-transaction snapshot, then ask the publisher to flush.",
      "before": "The upload callback receives the uncommitted record.",
      "after": "No upload claim, no upload, caller transaction preserved."
    },
    {
      "trigger": "Replace a pending persisted digest with a syntactically valid wrong SHA256.",
      "before": "The record becomes an upload claim and can be acknowledged.",
      "after": "Native503 before claim issuance or upload; outbox remains pending."
    }
  ],
