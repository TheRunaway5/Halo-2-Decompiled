#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
struct Material {uvec4 program[15];};
struct Fixture {Material material;vec4 samples[4];vec4 facing;vec4 glancing;vec4 fog;};
layout(set=0,binding=0,std430) readonly buffer Inputs {Fixture fixtures[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {vec4 pixels[];};
Material material;
vec4 suppliedFog;
#define H2_COMBINER_FOG() vec4(0.0,0.0,0.0,clamp(suppliedFog.x,0.0,1.0))
#include "combiner.glsl"
void main() {
    uint n=gl_GlobalInvocationID.x;material=fixtures[n].material;suppliedFog=fixtures[n].fog;
    pixels[n]=runCombiners(fixtures[n].samples,fixtures[n].facing,fixtures[n].glancing);
}
