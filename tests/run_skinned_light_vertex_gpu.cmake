# Every invocation retains a distinct output bank, including failed comparisons.
foreach(input TEST_BINARY MAP REFERENCES CAPTURE_SHADER)
    if(NOT EXISTS "${${input}}")
        message("SKIP: local model shader fixture unavailable: ${input}")
        return()
    endif()
endforeach()
string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(output "${OUTPUT_ROOT}/${stamp}-${suffix}")
if(NOT DEFINED EXPECTED_CLASSES)
    set(EXPECTED_CLASSES 4)
endif()
execute_process(COMMAND "${TEST_BINARY}" --skin "${MAP}" "${REFERENCES}"
    "${CAPTURE_SHADER}" "${output}" --classes "${EXPECTED_CLASSES}" RESULT_VARIABLE result)
if(result EQUAL 77)
    message("SKIP: local model shader required Vulkan features unavailable")
elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "Local model shader comparison failed (${result}); results: ${output}")
else()
    message("Local model shader results: ${output}")
endif()
