string(TIMESTAMP stamp "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(output "${OUTPUT_ROOT}/${stamp}-${suffix}")
execute_process(COMMAND "${TEST_BINARY}" "${FIXTURES}" "${output}" RESULT_VARIABLE result)
if(result EQUAL 77)
    message("SKIP: raw sphere renderer assets unavailable")
elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "Raw sphere renderer failed (${result}); results: ${output}")
else()
    message("Raw sphere renderer results: ${output}")
endif()
