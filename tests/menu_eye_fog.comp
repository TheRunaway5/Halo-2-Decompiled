#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
struct Fog {uvec4 program[15];vec4 lookup[2];};
struct Fixture {Fog material;vec4 depth;vec4 scene;};
layout(set=0,binding=0,std430) readonly buffer Inputs {Fixture fixtures[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {vec4 pixels[];};
Fog material;
#include "combiner.glsl"
vec4 fogGradient(vec2 uv) {return vec4(0);}
#include "fog_color.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    material=fixtures[i].material;
    vec4 scene=fixtures[i].scene;
    if(titleFogVisible(fixtures[i].depth.x)) {
        vec4 fog=titleFogColor(fixtures[i].depth.x);
        scene.rgb=fog.rgb+scene.rgb*(1.0-fog.a);
    }
    pixels[i]=scene;
}
