#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
struct Fixture {uvec4 instructions[136];vec4 attributes[16];vec4 constants[192];uvec4 flags;};
layout(set=0,binding=0,std430) readonly buffer Inputs {Fixture fixtures[];};
layout(set=0,binding=1,std430) writeonly buffer Outputs {vec4 outputs[];};
struct MaterialData {uvec4 vertexInstructions[136];vec4 vertexAttributes[16];uvec4 flags;};
MaterialData material;
vec4 constants[192];
#define H2_VERTEX_REFERENCE_INPUTS
#define H2_VERTEX_REFERENCE_CONSTANTS
vec4 vpConstant(uint index) {return constants[index];}
#include "vertex_program.glsl"
void main() {
    uint n=gl_GlobalInvocationID.x;
    material.flags=fixtures[n].flags;
    for(uint i=0u;i<136u;++i)material.vertexInstructions[i]=fixtures[n].instructions[i];
    for(uint i=0u;i<16u;++i)material.vertexAttributes[i]=fixtures[n].attributes[i];
    for(uint i=0u;i<192u;++i)constants[i]=fixtures[n].constants[i];
    runVertexProgram();
    outputs[n]=vpOut[0];
}
